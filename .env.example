OPENAI_API_KEY=sk-...
# 비우면 OpenAI 기본 주소. OpenAI 호환 프록시를 쓸 때만 지정
OPENAI_BASE_URL=

DATABASE_URL=postgresql://postgres:password@localhost:5432/youthlink
RAG_BASE_URL=http://localhost:8000
# RAG INTERNAL_API_KEY와 같은 값. RAG를 개발 모드로 띄웠으면 비워 둔다
RAG_INTERNAL_API_KEY=

# 데이터셋 생성 및 채점 LLM
GEN_MODEL=bedrock-gpt-5.6-luna
JUDGE_MODEL=bedrock-gpt-5.6-luna

# 임베딩 모델 ETL 서버와 통일
EMBEDDING_MODEL=bedrock-titan-embed-v2
# run --baseline 전용. RAG 서버와 통일
BASELINE_MODEL=bedrock-gpt-5.6-luna
# 채점·baseline LLM 동시 요청 상한 (게이트웨이 키당 제한 8 미만, 비우면 6)
LLM_MAX_CONCURRENCY=
